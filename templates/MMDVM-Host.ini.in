# Generated by scripts/render_configs.py from config.env.
# Edit config.env and re-render; do not edit this generated file.
#
# YSF is always enabled. D-Star and DMR are enabled only when configured;
# P25, NXDN, POCSAG and FM remain disabled so the add-on does not unexpectedly
# key the transmitter for another mode.

[General]
Callsign=@CALLSIGN@
Id=@MMDVM_ID@
Timeout=180
Duplex=0
RFModeHang=10
NetModeHang=3
Daemon=0

[Log]
MQTTLevel=0
DisplayLevel=1

[CW Id]
Enable=0
Time=10
Callsign=@CALLSIGN@

[Modem]
Protocol=uart
UARTPort=@MODEM_PORT@
UARTSpeed=@MODEM_BAUD@
RXFrequency=@FREQUENCY_HZ@
TXFrequency=@FREQUENCY_HZ@
TXInvert=1
RXInvert=0
PTTInvert=0
TXDelay=100
RXOffset=0
TXOffset=0
DMRDelay=0
RXLevel=50
TXLevel=50
RXDCOffset=0
TXDCOffset=0
RFLevel=100
RSSIMappingFile=
UseCOSAsLockout=0
Trace=0
Debug=0

[Transparent Data]
Enable=0

[D-Star]
Enable=@ENABLE_DSTAR@
Module=@DSTAR_MODULE@
SelfOnly=0
AckReply=1
AckTime=750
AckMessage=0
ErrorReply=1
RemoteGateway=0

[DMR]
Enable=@ENABLE_DMR@
Beacons=0
BeaconInterval=60
BeaconDuration=3
Id=@DMR_ID@
ColorCode=@DMR_COLOR_CODE@
SelfOnly=0
EmbeddedLCOnly=0
DumpTAData=0
CallHang=3
TXHang=4
Protect=0

[DMR Trunking]
Enable=0

[System Fusion]
Enable=1
LowDeviation=0
SelfOnly=0
TXHang=4
RemoteGateway=0

[P25]
Enable=0

[NXDN]
Enable=0

[POCSAG]
Enable=0

[FM]
Enable=0

[D-Star Network]
Enable=@ENABLE_DSTAR@
LocalAddress=127.0.0.1
LocalPort=20011
GatewayAddress=127.0.0.1
GatewayPort=20010
Debug=0

[DMR Network]
Enable=@ENABLE_DMR@
LocalAddress=127.0.0.1
LocalPort=62032
GatewayAddress=127.0.0.1
GatewayPort=62031
Jitter=360
Slot1=1
Slot2=1
Debug=0

[System Fusion Network]
Enable=1
LocalAddress=127.0.0.1
LocalPort=3200
GatewayAddress=127.0.0.1
GatewayPort=4200
Debug=0

[P25 Network]
Enable=0

[NXDN Network]
Enable=0

[POCSAG Network]
Enable=0

[FM Network]
Enable=0

[Lock File]
Enable=0

[Remote Control]
Enable=0
