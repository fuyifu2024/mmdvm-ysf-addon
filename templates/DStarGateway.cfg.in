# Generated by scripts/render_configs.py from config.env.
# Edit config.env and re-render; do not edit this generated file.
#
# Lightweight D-Star hotspot gateway (DStarGateway by F4FXL, wx-free).
# ircDDB is disabled; DPlus/DExtra/DCS/XLX are available for reflector
# linking. A registered D-Star callsign may be required by the reflector.

[Gateway]
type=hotspot
callsign=@CALLSIGN@
hbAddress=127.0.0.1
hbPort=20010
latitude=0.0
longitude=0.0
description1=@HOTSPOT_NAME@
description2=@HOTSPOT_DESC@
url=
language=english_us

[ircddb_1]
enabled=false
hostname=
username=
password=

[ircddb_2]
enabled=false
hostname=
username=
password=

[ircddb_3]
enabled=false
hostname=
username=
password=

[ircddb_4]
enabled=false
hostname=
username=
password=

[Repeater_1]
enabled=true
band=@DSTAR_MODULE@
callsign=@CALLSIGN@
address=127.0.0.1
port=20011
type=hb
reflector=@DSTAR_REFLECTOR@
reflectorAtStartup=true
reflectorReconnect=30
frequency=@FREQUENCY_MHZ@
offset=0.0
rangeKm=10
latitude=0.0
longitude=0.0
agl=
description1=@HOTSPOT_NAME@
description2=@HOTSPOT_DESC@
url=
band1=
band2=
band3=

[Repeater_2]
enabled=false

[Repeater_3]
enabled=false

[Repeater_4]
enabled=false

[APRS]
enabled=false
hostname=rotate.aprs2.net
port=14580
password=
positionSource=

[GPSD]
address=
port=

[Log]
path=/var/log/mmdvm/
fileRoot=dstargateway
fileRotate=true
fileLevel=info
displayLevel=info

[Paths]
data=/var/lib/mmdvm/dstargateway.d/

[DExtra]
enabled=true
maxDongles=5

[DPlus]
enabled=true
maxDongles=5
login=@CALLSIGN@

[DCS]
enabled=true

[XLX]
enabled=true
hostfileUrl=http://xlxapi.rlx.lu/api.php?do=GetXLXDMRMaster

[DRats]
enabled=false

[Remote]
enabled=false
port=4242
password=

[AccessControl]
whiteList=
blackList=
restrictList=

[Daemon]
daemon=false
pidfile=
user=mmdvm
