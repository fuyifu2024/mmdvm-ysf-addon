# Generated by scripts/render_configs.py from config.env.
# Edit config.env and re-render; do not edit this generated file.
#
# Important: the current YSFGateway source matches [Network] Startup with
# findByName(), so Startup must be the full reflector name, not the numeric
# designator.  render_configs.py enforces COUNTRY + "-" + NAME.

[General]
Callsign=@CALLSIGN@
Suffix=@SUFFIX@
Id=0
RptAddress=127.0.0.1
RptPort=3200
LocalAddress=127.0.0.1
LocalPort=4200
WiresXCommandPassthrough=0
Debug=0
Daemon=0

[Info]
RXFrequency=@FREQUENCY_HZ@
TXFrequency=@FREQUENCY_HZ@
Power=1
Latitude=0.0
Longitude=0.0
Height=0
Name=@HOTSPOT_NAME@
Description=@HOTSPOT_DESC@

[Log]
DisplayLevel=1
MQTTLevel=0

[APRS]
Enable=0
Description=@HOTSPOT_DESC@
Suffix=Y

[Network]
Startup=@REFLECTOR_STARTUP@
InactivityTimeout=0
Revert=0
Debug=0

[YSF Network]
Enable=1
Port=42000
Hosts=/etc/mmdvm/YSFHosts.json
ReloadTime=60
ParrotAddress=127.0.0.1
ParrotPort=0
YSF2DMRAddress=127.0.0.1
YSF2DMRPort=0
YSF2NXDNAddress=127.0.0.1
YSF2NXDNPort=0
YSF2P25Address=127.0.0.1
YSF2P25Port=0

[FCS Network]
Enable=0

[GPSD]
Enable=0

[Remote Commands]
Enable=0
