# Generated by scripts/render_configs.py from config.env.
# Edit config.env and re-render; do not edit this generated file.
#
# Minimal direct BrandMeister gateway: MMDVM-Host -> DMRGateway -> BM master.
# The hotspot security password is stored only in this file and config.env
# (both local, never committed).

[General]
Id=@DMR_ID@
Timeout=10
RptAddress=127.0.0.1
RptPort=62032
LocalAddress=127.0.0.1
LocalPort=62031
RuleTrace=0
Daemon=0
TrunkingEnabled=0
Debug=0

[Log]
DisplayLevel=1
MQTTLevel=0

[Voice]
Enabled=0

[Info]
Callsign=@CALLSIGN@
TXFrequency=@FREQUENCY_HZ@
RXFrequency=@FREQUENCY_HZ@
Power=1
ColorCode=@DMR_COLOR_CODE@
Duplex=0
Slot1=1
Slot2=1
Latitude=0.0
Longitude=0.0
Height=0
Location=Nowhere
Description=@HOTSPOT_DESC@
URL=

[XLX Network]
Enabled=0

[DMR Network 1]
Enabled=1
Name=BrandMeister
Address=@DMR_MASTER@
Port=@DMR_PORT@
Password=@DMR_PASSWORD@
Location=0
Debug=0
PassAllTG=1
PassAllTG=2
PassAllPC=1
PassAllPC=2

[GPSD]
Enable=0
Address=127.0.0.1
Port=2947

[APRS]
Enable=0
Description=@HOTSPOT_DESC@
Suffix=3

[Dynamic TG Control]
Enable=0

[Remote Commands]
Enable=0
