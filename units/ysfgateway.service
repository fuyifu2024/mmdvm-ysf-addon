[Unit]
Description=YSF Gateway for MMDVM
After=network-online.target
Wants=network-online.target

[Service]
User=mmdvm
Group=mmdvm
SupplementaryGroups=dialout
WorkingDirectory=/var/lib/mmdvm
ExecStart=/usr/local/bin/YSFGateway /etc/mmdvm/YSFGateway.ini
StandardOutput=append:/var/log/mmdvm/ysfgateway.log
StandardError=journal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
