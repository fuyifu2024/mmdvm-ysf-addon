# MMDVM YSF add-on example configuration.
# Copy to config.env, then edit for your own station.
#
#   cp config.example.env config.env
#   $EDITOR config.env
#   ./scripts/render_configs.py
#
# This example intentionally uses N0CALL / 438.8000 as a safe generic
# hotspot default.  Do not transmit on someone else's callsign.

# Your amateur call sign (uppercase letters/digits, 3-10 characters).
CALLSIGN=N0CALL

# YSF gateway suffix shown to the reflector (usually ND for a node).
SUFFIX=ND

# Simplex hotspot frequency in MHz.  Both RX and TX use this frequency.
# 438.8000 is a common UHF hotspot frequency in many regions.  Check your
# national band plan and local coordination before transmitting.
FREQUENCY=438.8000

# YSF reflector / room.  The current YSFGateway source matches "Startup" by
# the full name built from COUNTRY + "-" + NAME (see README), so all three
# fields must agree.  The default is the author's example reflector 46001.
REFLECTOR_ID=46001
REFLECTOR_COUNTRY=CN
REFLECTOR_NAME=C4FM-TG46001
REFLECTOR_DESC=China C4FM TG46001
REFLECTOR_STARTUP=CN-C4FM-TG46001
REFLECTOR_HOST=222.128.4.82
REFLECTOR_PORT=42000

# Optional labels used in YSFGateway Info and the OLED header.
HOTSPOT_NAME=N0CALL YSF Hotspot
HOTSPOT_DESC=MMDVM YSF add-on
