# MMDVM hotspot add-on example configuration (YSF, optional DMR/D-Star).
# Copy to config.env, then edit for your own station.
#
#   cp config.example.env config.env
#   $EDITOR config.env
#   ./scripts/render_configs.py
#
# This example intentionally uses N0CALL / 438.8000 as a safe generic
# hotspot default.  Do not transmit on someone else's callsign.

# Your amateur call sign (uppercase letters/digits, 3-10 characters).
CALLSIGN=N0CALL

# YSF gateway suffix shown to the reflector (usually ND for a node).
SUFFIX=ND

# Simplex hotspot frequency in MHz.  Both RX and TX use this frequency.
# 438.8000 is a common UHF hotspot frequency in many regions.  Check your
# national band plan and local coordination before transmitting.
FREQUENCY=438.8000

# Modem serial port. "auto" prefers a single /dev/serial/by-id path, then
# /dev/ttyAMA0, /dev/serial0, /dev/ttyUSB*, /dev/ttyACM*, /dev/ttySC*.
# If multiple serial devices exist, auto refuses to guess; set this explicitly.
# Pi 5/4/3 GPIO HAT: normally auto or /dev/ttyAMA0.
# x86 + USB MMDVM modem: normally auto or /dev/ttyUSB0 / /dev/ttyACM0.
MODEM_PORT=auto

# Modem baud rate. 115200 is the tested setting for the MMDVM_HS HAT.
MODEM_BAUD=115200

# Optional I2C OLED.
#   auto = probe 0x3C at install time
#   0    = no OLED (x86 usually has no Pi I2C header)
#   1    = force; requires /dev/i2c-<I2C_BUS> and the configured address
ENABLE_OLED=auto
I2C_BUS=1
I2C_ADDRESS=0x3C
# auto = SSD1306 family (the tested HAT). ssd1309/ssd1315 are aliases.
# Select sh1106 for a 1.3" SH1106 display (128x64 only).
OLED_CONTROLLER=auto
# 128x64 (0.96"), 128x32 (0.91"), 64x48 (small); SH1106 supports 128x64 here.
OLED_SIZE=128x64
# 0 = normal, 180 = upside-down mounting.
OLED_ROTATE=0
# 0x00-0xFF; 0xCF is the tested default.
OLED_CONTRAST=0xCF

# Optional DMR network (direct BrandMeister through DMRGateway).
# Leave disabled unless you have a DMR ID and a BrandMeister hotspot password.
# The password is only stored in config.env and /etc/mmdvm/DMRGateway.ini.
ENABLE_DMR=0
DMR_ID=0
DMR_MASTER=4601.master.brandmeister.network
DMR_PORT=62031
DMR_PASSWORD=
DMR_COLOR_CODE=1

# Optional D-Star network (DStarGateway).
# Reflector syntax example: REF001 C (DPlus), XRF012 C, DCS001 C or XLX123 C.
# A registered D-Star callsign may be required by the reflector.
ENABLE_DSTAR=0
DSTAR_REFLECTOR=
DSTAR_MODULE=C

# YSF reflector / room.  The current YSFGateway source matches "Startup" by
# the full name built from COUNTRY + "-" + NAME (see README), so all three
# fields must agree.  The default is the author's example reflector 46001.
REFLECTOR_ID=46001
REFLECTOR_COUNTRY=CN
REFLECTOR_NAME=C4FM-TG46001
REFLECTOR_DESC=China C4FM TG46001
REFLECTOR_STARTUP=CN-C4FM-TG46001
REFLECTOR_HOST=222.128.4.82
REFLECTOR_PORT=42000

# Optional labels used in YSFGateway Info and the OLED header.
HOTSPOT_NAME=N0CALL YSF Hotspot
HOTSPOT_DESC=MMDVM YSF add-on
